# SecondNature 环境变量配置示例
# 复制此文件为 .env 并填入真实的API密钥

# ========================================
# 必需配置
# ========================================

# DeepSeek API密钥
# 获取地址: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# 阿里云百炼 API密钥（用于RAG文本嵌入）
# 获取地址: https://bailian.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# JWT密钥（至少32字符，用于用户认证）
# 建议使用随机字符串生成器生成
JWT_SECRET_KEY=your-secret-key-must-be-at-least-32-characters-long

# ========================================
# 可选配置
# ========================================

# DeepSeek API基础URL（默认官方地址）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek模型名称（默认 deepseek-chat）
DEEPSEEK_MODEL=deepseek-chat

# ========================================
# 数据库配置（可选，默认使用SQLite）
# ========================================

# MYSQL_DIALECT=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=root
# MYSQL_PASSWORD=your_mysql_password
# MYSQL_DATABASE=secondnature

# ========================================
# 小智硬件桥接配置（可选）
# ========================================

# 小智智能体名称：硬件连接时必须声明此名称，才会被路由到本系统
# XIAOZHI_AGENT_NAME=second-nature

# 系统级接入令牌：若设置，硬件必须携带相同 token 才能接入
# XIAOZHI_SYSTEM_TOKEN=your-xiaozhi-system-token

# 设备声纹白名单开关：true 时自动记录新设备为 pending，仅明确 blocked 的设备会被拒绝
# XIAOZHI_DEVICE_WHITELIST_ENABLED=false

# 小智代理服务器 WebSocket 地址（后端会把无法本地处理的音频转发过去）
# XIAOZHI_SERVER_URL=ws://localhost:8000/xiaozhi

# ========================================
# RAG配置（可选）
# ========================================

# 知识库路径
RAG_KNOWLEDGE_BASE_PATH=./rag/data

# 向量数据库路径（与知识库文档分离，便于独立备份/重建）
RAG_VECTOR_DB_PATH=./rag/indices/faiss

# 跳过RAG初始化（用于快速启动，当向量数据库已存在时）
# SKIP_RAG_INIT=true
